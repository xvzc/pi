{
  "defaultShell": "zsh",
  "includeCoAuthoredBy": false,
  "quietStartup": false,
  "packages": [
    "npm:pi-mcp-adapter",
    "npm:pi-web-access",
    "npm:pi-minimal-footer",
    "npm:pi-startup-header",
    "npm:@tintinweb/pi-subagents@0.19.0",
    "npm:pi-tool-display",
    "npm:pi-ask-user",
    "npm:@tintinweb/pi-tasks"
  ],
  "theme": "neon-green",
  "tuiMode": "fullscreen",
  "lastChangelogVersion": "0.85.1",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-terra",
  "defaultThinkingLevel": "medium",
  "doubleEscapeAction": "none",
  "hideThinkingBlock": true,
  "showLastPrompt": false,
  "powerline": {
    "preset": "compact",
    "placement": "below",
    "welcome": false
  },
  "pi-ask-user": {
    "displayMode": "inline"
  }
}
